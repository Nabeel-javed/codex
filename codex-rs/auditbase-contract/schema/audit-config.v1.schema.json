{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditConfig",
  "type": "object",
  "required": [
    "runtime",
    "schema_version",
    "tiers"
  ],
  "properties": {
    "runtime": {
      "$ref": "#/definitions/RuntimeConfig"
    },
    "schema_version": {
      "$ref": "#/definitions/AuditConfigSchemaVersion"
    },
    "tiers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/TierConfig"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AuditConfigSchemaVersion": {
      "type": "string",
      "enum": [
        "auditbase.audit-config.v1"
      ]
    },
    "ContractLimits": {
      "type": "object",
      "required": [
        "max_diagnostic_item_bytes",
        "max_diagnostics_bytes",
        "max_event_bytes",
        "max_evidence_item_bytes",
        "max_finding_evidence_bytes",
        "max_guidance_bytes",
        "max_log_message_bytes",
        "max_request_bytes",
        "max_result_bytes",
        "max_snippet_bytes"
      ],
      "properties": {
        "max_diagnostic_item_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_diagnostics_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_event_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_evidence_item_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_finding_evidence_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_guidance_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_log_message_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_request_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_result_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 268435456.0,
          "minimum": 0.0
        },
        "max_snippet_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "controlled_public",
        "benchmark_model_only"
      ]
    },
    "ReasoningEffort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "RuntimeConfig": {
      "type": "object",
      "required": [
        "artifact_retention_hours",
        "contract_limits",
        "event_retention_hours",
        "max_concurrent_audits",
        "max_upload_bytes",
        "max_upload_files",
        "network_access",
        "worker_cpu_cores",
        "worker_disk_mib",
        "worker_memory_mib"
      ],
      "properties": {
        "artifact_retention_hours": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "contract_limits": {
          "$ref": "#/definitions/ContractLimits"
        },
        "event_retention_hours": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_concurrent_audits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_upload_bytes": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "max_upload_files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "network_access": {
          "$ref": "#/definitions/NetworkAccess"
        },
        "worker_cpu_cores": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "worker_disk_mib": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "worker_memory_mib": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "TierConfig": {
      "type": "object",
      "required": [
        "audit_timeout_minutes",
        "enabled",
        "model",
        "reasoning_effort"
      ],
      "properties": {
        "audit_timeout_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "reasoning_effort": {
          "description": "Passed to Codex as the model reasoning effort without exposing it publicly.",
          "allOf": [
            {
              "$ref": "#/definitions/ReasoningEffort"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
